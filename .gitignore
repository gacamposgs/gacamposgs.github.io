# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
__pycache__/

# Ignore the directory for local files during development
local/

# Local reference material and academic records (keep the public CV tracked)
/tips_academic_website.pdf
/files/Provisional_Transcript_Gabriel.pdf

# Personal editing guides stay in this checkout only
/EDITING.md
/content/README.md

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file and bundle for alternative installation
vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/
